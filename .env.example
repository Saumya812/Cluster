# Copy to .env and fill in. Never commit .env.

# GitHub API — repo data for city buildings
GITHUB_TOKEN=

# Free key from https://aistudio.google.com/apikey — city tour guide + Quiz tab question generation
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# YouTube Data API v3 — playlists + visualization videos in side panel
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Google Custom Search — Reading tab results
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
# Programmable Search Engine ID ("cx")
GOOGLE_CSE_ID=

# OpenAlex — Papers tab (optional; works without a key at lower rate limits)
OPENALEX_API_KEY=

# ElevenLabs — building narration voice
ELEVENLABS_API_KEY=
# Optional overrides
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_monolingual_v1

# TigerData (Timescale Postgres) — learner progress; falls back to local SQLite if empty
# TIMESCALE_SERVICE_URL is also accepted
TIGERDATA_URL=

# Backboard — learner memory across sessions
BACKBOARD_API_KEY=

# Apify — broad topic crawl for city buildings (optional; seed fallback used if empty)
APIFY_API_KEY=

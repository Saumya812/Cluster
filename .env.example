# Copy to .env and fill in. Never commit .env.

GITHUB_TOKEN=
# Free key from https://aistudio.google.com/apikey — used by the city tour guide
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# YouTube Data API v3 — playlists + visualization videos in side panel
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Google Custom Search — Reading tab results
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=d76e1a7c64f04452a

# Apify — broad topic crawl for city buildings (optional; seed fallback used if empty)
APIFY_API_KEY=

# Anthropic Claude — Quiz tab question generation
ANTHROPIC_API_KEY=
